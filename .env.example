# WhatsApp Commerce Platform — Environment Variables
# Copy this to .env and fill in your values

# --- App ---
DEBUG=true
SECRET_KEY=your-secret-key-here

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_commerce

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key

# --- WhatsApp Business Cloud API ---
WA_PHONE_NUMBER_ID=your-phone-number-id
WA_ACCESS_TOKEN=your-access-token
WA_VERIFY_TOKEN=your-verify-token
WA_APP_SECRET=your-app-secret

# --- Auth ---
JWT_SECRET_KEY=your-jwt-secret

# --- Default Seller ---
DEFAULT_BUSINESS_NAME=My Store
DEFAULT_PRODUCT_CATEGORY=general merchandise
DEFAULT_AUTO_APPROVE_LIMIT=25000
